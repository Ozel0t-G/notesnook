+    },
+    secondary: {
+      background: "#16161B",
+      paragraph: "#C8C8C8",
+      icon: "#909090"
+    },
+    selected: {
+      background: "#3A3A45",
+      accent: "#FF9500"
+    }
+  } as unknown as TokenColors);
