// Private VeyraN TestFlight display name; stable identifiers are preserved.
IOS_CURRENT_PROJECT_VERSION = 21
IOS_MARKETING_VERSION = 3.4.16
IOS_MAIN_BUNDLE_ID = com.ozel0t.note.notesnookpencil
IOS_WIDGET_BUNDLE_ID = com.ozel0t.note.notesnookpencil.widget
IOS_SHARE_BUNDLE_ID = com.ozel0t.note.notesnookpencil.share
// Mac Catalyst: own IDs so the Electron Mac app keeps com.ozel0t.note.notesnookpencil.
IOS_MAIN_BUNDLE_ID[sdk=macosx*] = com.ozel0t.note.notesnookpencil.mac
IOS_WIDGET_BUNDLE_ID[sdk=macosx*] = com.ozel0t.note.notesnookpencil.mac.widget
IOS_SHARE_BUNDLE_ID[sdk=macosx*] = com.ozel0t.note.notesnookpencil.mac.share
// Mac Catalyst is built for Apple Silicon only.
EXCLUDED_ARCHS[sdk=macosx*] = x86_64
APP_DISPLAY_NAME = VeyraN
// Automatic signing: no provisioning profile names.
IOS_MAIN_PROFILE =
IOS_WIDGET_PROFILE =
IOS_SHARE_PROFILE =
